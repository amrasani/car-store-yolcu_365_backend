{
  "kind": "collectionType",
  "collectionName": "cars",
  "info": {
    "singularName": "car",
    "pluralName": "cars",
    "displayName": "car"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "price": {
      "type": "decimal"
    },
    "year": {
      "type": "integer"
    },
    "fuel_type": {
      "type": "enumeration",
      "enum": [
        "Gasoline",
        "Diesel",
        "Electric",
        "Hybrid"
      ]
    },
    "transmission": {
      "type": "enumeration",
      "enum": [
        "Automatic",
        "Manual"
      ]
    },
    "main_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "description": {
      "type": "blocks"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "cars"
    },
    "mileage": {
      "type": "decimal"
    },
    "dealer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::dealer.dealer",
      "inversedBy": "cars"
    }
  }
}
